{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orch",
  "identifier": "do.alpha.orch",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orch",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Johan Perez",
    "copyright": "Copyright (c) 2026 Johan Perez",
    "category": "DeveloperTool",
    "shortDescription": "Orquestación y transporte de datos",
    "longDescription": "Pipelines de datos como YAML o en un lienzo: orígenes, transformaciones SQL y destinos, ejecutados en streaming sobre Arrow, con historial, alertas, lineage por columna y versiones en git.",
    "homepage": "https://github.com/johan7perez/orch",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../examples/pipelines/*.yaml": "ejemplos/pipelines/",
      "../../examples/data/*.csv": "ejemplos/data/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libssl3"
        ]
      },
      "rpm": {
        "depends": [
          "libssl.so.3()(64bit)"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ]
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
